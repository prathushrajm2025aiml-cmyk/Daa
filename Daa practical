4-G-Array Sum max problem
#include <stdio.h>
#include <stdlib.h>
int compare_asc(const void *a, const void *b) {
long long int_a = *(long long *)a;
long long int_b = *(long long *)b;
if (int_a > int_b) return 1;
if (int_a < int_b) return -1;
return 0;
}
int main() {
int n;
if (scanf("%d", &n) != 1) return 0;
long long *arr = (long long *)malloc(n * sizeof(long long));
if (arr == NULL) return 0; for (int i = 0; i < n; i++) {
scanf("%lld", &arr[i]);
}
qsort(arr, n, sizeof(long long), compare_asc);
long long max_sum = 0;
for (int i = 0; i < n; i++) {
max_sum += arr[i] * i;
}
printf("%lld\n", max_sum);
free(arr);
return 0;
}
