3-DP-Longest Common Subsequence
#include <stdio.h>
#include <string.h>
int main() {
char s1[1000], s2[1000];
scanf("%s", s1);
scanf("%s", s2);
int n = strlen(s1);
int m = strlen(s2);
int dp[n + 1][m + 1];
for (int i = 0; i <= n; i++) {
for (int j = 0; j <= m; j++) {
if (i == 0 || j == 0) {
dp[i][j] = 0; }
else if (s1[i - 1] == s2[j - 1]) {
dp[i][j] = dp[i - 1][j - 1] + 1;
}
else {
dp[i][j] = dp[i - 1][j] > dp[i][j - 1]
? dp[i - 1][j]
: dp[i][j - 1];
}
}
}
printf("%d", dp[n][m]);
return 0;
}
4-DP-Longest non-decreasing Subsequence
