GREEDY ALGORITHMS
1-G-Coin Problem
#include <stdio.h>
int main() { int amount;
if (scanf("%d", &amount) != 1) return 0;
int denominations[] = {1000, 500, 100, 50, 20, 10, 5, 2, 1};
int n = sizeof(denominations) / sizeof(denominations[0]);
int total_count = 0;
for (int i = 0; i < n; i++) {
if (amount == 0) {
break;
}
total_count += amount / denominations[i];
amount %= denominations[i];
}
printf("%d\n", total_count);
return 0;
}
2-G-Cookies Problem
#include <stdio.h>
#include <stdlib.h>
int compare(const void *a, const void *b) { return (*(int *)a - *(int *)b);
}
int main() {
int n;
if (scanf("%d", &n) != 1) return 0;
int *g = (int *)malloc(n * sizeof(int));
for (int i = 0; i < n; i++) {
scanf("%d", &g[i]);
}
int m;
if (scanf("%d", &m) != 1) return 0;
int *s = (int *)malloc(m * sizeof(int));
for (int j = 0; j < m; j++) {
scanf("%d", &s[j]);
}
qsort(g, n, sizeof(int), compare);
qsort(s, m, sizeof(int), compare);
int child_ptr = 0;
int cookie_ptr = 0; while (child_ptr < n && cookie_ptr < m) {
if (s[cookie_ptr] >= g[child_ptr]) {
child_ptr++;
}
cookie_ptr++;
}
printf("%d\n", child_ptr);
free(g);
free(s);
return 0;
}
